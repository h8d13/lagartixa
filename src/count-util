#!/bin/bash
# count-util — spot heavy dep chains
# requires: pacman-contrib (pactree)
# usage: ./count-util [pkg]
#   no arg: show top 20 packages by unique dep count
#   pkg:    show dep tree + required-by for that package

if [ -z "$1" ]; then
    echo "# Top 20 packages by unique dependency count"
    for p in $(pacman -Qqe); do
        echo "$(( $(pactree -u "$p" 2>/dev/null | wc -l) - 1 ))   $p"
    done | sort -rn | head -20
else
    pkg="$1"
    if ! pacman -Qi "$pkg" &>/dev/null; then
        echo "error: package '$pkg' not found" >&2
        exit 1
    fi
    echo "# Dep tree for: $pkg"
    pactree "$pkg"
    echo ""
    echo "# Required by: $pkg"
    pactree -r "$pkg"
fi
